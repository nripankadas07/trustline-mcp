{
  "version": "trustline.audit-bundle/v1",
  "policy": {
    "version": "trustline.policy/v1",
    "name": "offline-attack-lab",
    "defaultEffect": "deny",
    "toolRules": [
      {
        "id": "allow-read",
        "effect": "allow",
        "tools": [
          "repo.read"
        ]
      },
      {
        "id": "allow-search",
        "effect": "allow",
        "tools": [
          "docs.search"
        ]
      },
      {
        "id": "approve-shell",
        "effect": "approval",
        "tools": [
          "shell.safe"
        ]
      },
      {
        "id": "deny-system",
        "effect": "deny",
        "tools": [
          "system.*"
        ]
      }
    ],
    "argumentRules": [
      {
        "id": "deny-rm",
        "effect": "deny",
        "tool": "shell.safe",
        "path": "command",
        "operator": "matches",
        "value": "\\brm\\b"
      },
      {
        "id": "deny-sudo",
        "effect": "deny",
        "tool": "shell.safe",
        "path": "command",
        "operator": "matches",
        "value": "\\bsudo\\b"
      },
      {
        "id": "deny-curl",
        "effect": "deny",
        "tool": "shell.safe",
        "path": "command",
        "operator": "matches",
        "value": "\\bcurl\\b"
      },
      {
        "id": "deny-wget",
        "effect": "deny",
        "tool": "shell.safe",
        "path": "command",
        "operator": "matches",
        "value": "\\bwget\\b"
      },
      {
        "id": "deny-force",
        "effect": "deny",
        "tool": "shell.safe",
        "path": "command",
        "operator": "matches",
        "value": "--force"
      }
    ],
    "pathRules": [
      {
        "id": "workspace-only",
        "effect": "allow",
        "tool": "repo.read",
        "argument": "path",
        "roots": [
          "/workspace"
        ]
      }
    ],
    "hostRules": [
      {
        "id": "docs-hosts",
        "effect": "allow",
        "tool": "docs.search",
        "argument": "url",
        "hosts": [
          "docs.example.test"
        ]
      },
      {
        "id": "deny-link-local",
        "effect": "deny",
        "tool": "*",
        "argument": "url",
        "hosts": [
          "169.254.169.254",
          "localhost"
        ]
      }
    ],
    "quotas": [
      {
        "id": "search-quota",
        "tool": "docs.search",
        "limit": 2
      }
    ],
    "redactKeys": [
      "privateNote"
    ]
  },
  "policyDigest": "1ef2a32bfb866993e019b91c5b28a9679c8f15ea5485de4fb55ddc21fe17898f",
